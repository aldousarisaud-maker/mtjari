# Copy to .env and fill in. Never commit real values.
# Generate secrets with:  openssl rand -hex 32   /   openssl rand -base64 32

# --- Database (see infra/postgres/bootstrap.sh) ---
DATABASE_OWNER_URL=postgresql://mtjari_owner:CHANGE_ME@localhost:5432/mtjari
SHADOW_DATABASE_URL=postgresql://mtjari_owner:CHANGE_ME@localhost:5432/mtjari_shadow
DATABASE_URL=postgresql://mtjari_app:CHANGE_ME@localhost:5432/mtjari
TEST_DATABASE_OWNER_URL=postgresql://mtjari_owner:CHANGE_ME@localhost:5432/mtjari_test
TEST_DATABASE_URL=postgresql://mtjari_app:CHANGE_ME@localhost:5432/mtjari_test

# --- API ---
PORT=4000
JWT_ACCESS_SECRET=            # >= 32 chars
ENCRYPTION_KEYS=              # v1:<base64 of 32 random bytes>   (comma-separate to rotate, newest first)
WEB_URL=http://localhost:3000
ROOT_DOMAIN=mtjari.cc
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=0            # 1 behind a single reverse proxy
MAIL_TRANSPORT=smtp           # "log" for local dev without SMTP (links are NOT delivered)
SMTP_URL=                     # smtp://user:pass@host:587
MAIL_FROM=Mtjari <no-reply@mtjari.cc>

# --- Web ---
API_URL=http://localhost:4000
