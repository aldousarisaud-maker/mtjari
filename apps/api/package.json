{
  "name": "@mtjari/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js)",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=src/",
    "test:e2e": "jest --runInBand --testPathPatterns=test/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1168.0",
    "@mtjari/db": "workspace:*",
    "@mtjari/shared": "workspace:*",
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.2",
    "dotenv": "17.2.3",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.10",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.19.1",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.15.6",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pg": "8.16.3",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            },
            "target": "es2022"
          }
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts",
      "<rootDir>/test/**/*.e2e-spec.ts"
    ],
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "testTimeout": 30000
  }
}
