# Rendered by the nginx image's envsubst (ROOT_DOMAIN). TLS certificates are
# issued with certbot (see docs/DEPLOYMENT.md) into the shared "certs" volume.
limit_req_zone $binary_remote_addr zone=perip:10m rate=20r/s;

server {
  listen 80;
  server_name ${ROOT_DOMAIN} www.${ROOT_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/acme; }
  location / { return 301 https://${ROOT_DOMAIN}$request_uri; }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${ROOT_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  client_max_body_size 10m;
  server_tokens off;

  # Product images (local storage driver). With S3/CDN storage this block is unused.
  location /media/ {
    proxy_pass http://api:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    add_header X-Content-Type-Options nosniff always;
  }

  location / {
    limit_req zone=perip burst=60 nodelay;
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # Overwrite (never append): the client must not be able to spoof its IP.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
