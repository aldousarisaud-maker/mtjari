{
  "name": "mtjari",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @mtjari/db generate",
    "db:migrate": "pnpm --filter @mtjari/db migrate:deploy",
    "db:seed": "pnpm --filter @mtjari/db seed"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  }
}
