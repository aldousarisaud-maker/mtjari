// Mtjari.cc — Phase 1 schema (identity, tenancy, RBAC, audit).
// Tenant-scoped tables carry store_id and are protected by Postgres
// Row-Level Security (see migrations/*_rls). Full roadmap schema lives in
// docs/DATABASE_SCHEMA.md.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  NONE
  SUPPORT
  SUPER_ADMIN
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING_VERIFICATION
  VERIFIED
  ACTIVE
  FAILED
}

enum SslStatus {
  NONE
  PENDING
  ISSUED
  FAILED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ActorType {
  USER
  SYSTEM
  PLATFORM_ADMIN
}

/// Global identity. Not tenant-scoped: one person can belong to many stores.
model User {
  id                String       @id @default(uuid()) @db.Uuid
  email             String       @unique
  name              String
  passwordHash      String       @map("password_hash")
  locale            String       @default("ar")
  status            UserStatus   @default(ACTIVE)
  platformRole      PlatformRole @default(NONE) @map("platform_role")
  emailVerifiedAt   DateTime?    @map("email_verified_at")
  /// AES-256-GCM encrypted TOTP secret (never stored in plaintext).
  mfaSecretEnc      String?      @map("mfa_secret_enc")
  mfaEnabledAt      DateTime?    @map("mfa_enabled_at")
  /// SHA-256 hashes of one-time recovery codes.
  mfaRecoveryHashes String[]     @default([]) @map("mfa_recovery_hashes")
  failedLoginCount  Int          @default(0) @map("failed_login_count")
  lockedUntil       DateTime?    @map("locked_until")
  lastLoginAt       DateTime?    @map("last_login_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  sessions    Session[]
  emailTokens EmailToken[]
  memberships Membership[]

  @@map("users")
}

/// Rotating refresh tokens. A reused (already rotated) token revokes its whole family.
model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model EmailToken {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      EmailTokenType
  tokenHash String         @unique @map("token_hash")
  expiresAt DateTime       @map("expires_at")
  usedAt    DateTime?      @map("used_at")
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("email_tokens")
}

/// The tenant. Every merchant-owned row references a store.
model Store {
  id            String      @id @default(uuid()) @db.Uuid
  name          String
  slug          String      @unique
  businessType  String      @default("other") @map("business_type")
  country       String      @default("KW") @db.Char(2)
  currency      String      @default("KWD") @db.Char(3)
  defaultLocale String      @default("ar") @map("default_locale")
  status        StoreStatus @default(DRAFT)
  createdById   String?     @map("created_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deletedAt     DateTime?   @map("deleted_at")

  domains     StoreDomain[]
  roles       Role[]
  memberships Membership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  categories  Category[]
  brands      Brand[]
  products    Product[]

  @@map("stores")
}

model StoreDomain {
  id                String       @id @default(uuid()) @db.Uuid
  storeId           String       @map("store_id") @db.Uuid
  hostname          String       @unique
  type              DomainType
  status            DomainStatus @default(PENDING_VERIFICATION)
  sslStatus         SslStatus    @default(NONE) @map("ssl_status")
  isPrimary         Boolean      @default(false) @map("is_primary")
  verificationToken String?      @map("verification_token")
  verifiedAt        DateTime?    @map("verified_at")
  lastCheckedAt     DateTime?    @map("last_checked_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_domains")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  storeId     String   @map("store_id") @db.Uuid
  /// Set for built-in roles (owner, admin, ...); null for custom roles.
  key         String?
  name        String
  permissions String[] @default([])
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  memberships Membership[]
  invitations Invitation[]

  @@unique([storeId, name])
  @@unique([storeId, key])
  @@map("roles")
}

model Membership {
  id        String           @id @default(uuid()) @db.Uuid
  storeId   String           @map("store_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(uuid()) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  email       String
  roleId      String    @map("role_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("invitations")
}

/// Append-only. The application DB role has INSERT + SELECT only.
model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  storeId     String?   @map("store_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @default(USER) @map("actor_type")
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    Json      @default("{}")
  ip          String?
  userAgent   String?   @map("user_agent")
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------
// Phase 2: catalogue and inventory. All tables are tenant-scoped (RLS).
// Child tables reference their parent with a composite (store_id, id)
// foreign key, so a row can never point at another store's row even
// though foreign-key checks themselves bypass RLS.
// Money is stored as integer minor units (fils/halalas) of the store currency.
// ---------------------------------------------------------------------

enum ProductType {
  SIMPLE
  VARIANT
  DIGITAL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductRelationType {
  RELATED
  UPSELL
  CROSS_SELL
}

enum InventoryReason {
  INITIAL
  RESTOCK
  ADJUSTMENT
  DAMAGE
  RETURN
  SALE
  CORRECTION
  IMPORT
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  storeId        String   @map("store_id") @db.Uuid
  /// Validated in the service to belong to the same store (nullable, so not composite).
  parentId       String?  @map("parent_id") @db.Uuid
  nameAr         String?  @map("name_ar")
  nameEn         String?  @map("name_en")
  slug           String
  descriptionAr  String?  @map("description_ar")
  descriptionEn  String?  @map("description_en")
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@unique([storeId, slug])
  @@unique([storeId, id])
  @@index([storeId, parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@map("brands")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  type           ProductType   @default(SIMPLE)
  status         ProductStatus @default(DRAFT)
  nameAr         String?       @map("name_ar")
  nameEn         String?       @map("name_en")
  slug           String
  descriptionAr  String?       @map("description_ar")
  descriptionEn  String?       @map("description_en")
  /// Validated in the service to belong to the same store.
  brandId        String?       @map("brand_id") @db.Uuid
  tags           String[]      @default([])
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  brand      Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  options    ProductOption[]
  variants   ProductVariant[]
  media      ProductMedia[]
  categories ProductCategory[]
  relations  ProductRelation[] @relation("RelationSource")
  relatedBy  ProductRelation[] @relation("RelationTarget")

  @@unique([storeId, slug])
  @@unique([storeId, id])
  @@index([storeId, status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductOption {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  name      String
  values    String[]
  position  Int      @default(0)

  product Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@unique([productId, name])
  @@map("product_options")
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  storeId           String   @map("store_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  sku               String?
  barcode           String?
  /// e.g. {"Color":"Red","Size":"M"}; {} for the single variant of a simple product.
  optionValues      Json     @default("{}") @map("option_values")
  price             Int
  compareAtPrice    Int?     @map("compare_at_price")
  cost              Int?
  trackInventory    Boolean  @default(true) @map("track_inventory")
  /// Cached balance; the source of truth is the inventory_movements ledger.
  stockQuantity     Int      @default(0) @map("stock_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product   Product             @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([storeId, sku])
  @@unique([storeId, id])
  @@index([productId])
  @@map("product_variants")
}

model ProductMedia {
  id         String   @id @default(uuid()) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  /// Storage key prefix; rendered sizes live at `${keyBase}-${width}.webp`.
  keyBase    String   @map("key_base")
  widths     Int[]
  width      Int
  height     Int
  altAr      String?  @map("alt_ar")
  altEn      String?  @map("alt_en")
  position   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_media")
}

model ProductCategory {
  storeId    String @map("store_id") @db.Uuid
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  product  Product  @relation(fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  category Category @relation(fields: [storeId, categoryId], references: [storeId, id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductRelation {
  storeId          String              @map("store_id") @db.Uuid
  productId        String              @map("product_id") @db.Uuid
  relatedProductId String              @map("related_product_id") @db.Uuid
  type             ProductRelationType
  position         Int                 @default(0)

  product Product @relation("RelationSource", fields: [storeId, productId], references: [storeId, id], onDelete: Cascade)
  related Product @relation("RelationTarget", fields: [storeId, relatedProductId], references: [storeId, id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@map("product_relations")
}

/// Append-only stock ledger. The runtime role has INSERT + SELECT only.
model InventoryMovement {
  id            String          @id @default(uuid()) @db.Uuid
  storeId       String          @map("store_id") @db.Uuid
  variantId     String          @map("variant_id") @db.Uuid
  delta         Int
  quantityAfter Int             @map("quantity_after")
  reason        InventoryReason
  note          String?
  actorUserId   String?         @map("actor_user_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [storeId, variantId], references: [storeId, id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([variantId, createdAt(sort: Desc)])
  @@map("inventory_movements")
}
